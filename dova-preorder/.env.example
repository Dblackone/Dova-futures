PORT=3001
PREORDER_DB_PATH=./preorder.db
# Optional: set to a persistent-disk path (e.g. on Render) to keep uploaded
# product images across redeploys. If unset, defaults to public/uploads.
UPLOAD_DIR=
APP_URL=https://preorder.dovafutures.com

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Admin
ADMIN_PASSWORD=change-this-to-something-strong

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@dovafutures.com
