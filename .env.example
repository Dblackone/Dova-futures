# Dova Futures — environment variables
#
# Contact form (static-export compatible) posts to Web3Forms.
# Create a free access key at https://web3forms.com and paste it below.
# This value is PUBLIC by design (it only authorizes form delivery to the
# email tied to the key); the NEXT_PUBLIC_ prefix exposes it to the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# --- Legacy self-hosted Express fallback (server.js, NOT deployed to Pages) ---
PORT=3000
CONTACT_TO_EMAIL=info@dovafutures.com
CONTACT_FROM_EMAIL=no-reply@dovafutures.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
