{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["document_reference", "document_date", "valid_until", "currency", "company", "client", "project", "items", "tax", "discount", "terms", "authorised_signatory"],
  "additionalProperties": false,
  "properties": {
    "document_reference": { "type": "string", "minLength": 1 },
    "document_date": { "type": "string", "minLength": 1 },
    "valid_until": { "type": "string", "minLength": 1 },
    "currency": { "type": "object", "required": ["code", "symbol", "decimal_places"], "additionalProperties": false, "properties": { "code": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 }, "decimal_places": { "type": "integer", "minimum": 0, "maximum": 6 } } },
    "company": { "type": "object", "required": ["name", "address", "phone", "email"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "address": { "type": "string", "minLength": 1 }, "phone": { "type": "string", "minLength": 1 }, "email": { "type": "string", "format": "email" } } },
    "client": { "type": "object", "required": ["name", "address", "phone", "email"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "company": { "type": "string" }, "address": { "type": "string", "minLength": 1 }, "phone": { "type": "string", "minLength": 1 }, "email": { "type": "string", "format": "email" } } },
    "project": { "type": "object", "required": ["title", "location"], "additionalProperties": false, "properties": { "title": { "type": "string", "minLength": 1 }, "location": { "type": "string", "minLength": 1 } } },
    "introduction": { "type": "string" },
    "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["description", "quantity", "unit", "rate"], "additionalProperties": false, "properties": { "description": { "type": "string", "minLength": 1 }, "specification": { "type": "string" }, "quantity": { "type": "number", "minimum": 0 }, "unit": { "type": "string", "minLength": 1 }, "rate": { "type": "number", "minimum": 0 } } } },
    "tax": { "type": "object", "required": ["enabled", "rate_percent"], "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "rate_percent": { "type": "number", "minimum": 0, "maximum": 100 } } },
    "discount": { "type": "object", "required": ["enabled", "amount"], "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "amount": { "type": "number", "minimum": 0 } } },
    "terms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "authorised_signatory": { "type": "object", "required": ["name", "position"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "position": { "type": "string", "minLength": 1 }, "signature_image": { "type": ["string", "null"] } } }
  }
}
