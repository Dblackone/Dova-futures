# ─────────────────────────────────────────────────────────────────────────────
# .env.ai.example — LOCAL AI-ASSISTED DEVELOPMENT
#
# Copy to `.env.ai` and fill in. `.env.ai` is gitignored; this example is not.
#
#   cp .env.ai.example .env.ai
#
# ⚠ IMPORTANT — no application code in this repository reads these variables.
# server.js and dova-preorder/server.js load only their own `.env`. This file
# configures the TOOLS YOU RUN AROUND the repo (LM Studio clients, editor
# extensions, agent CLIs, attribution scripts), and it exists so that
# configuration is written down in one place instead of living in your shell
# history. Load it explicitly in whichever tool needs it.
#
# Related: governance/agents/AGENTS.md (the shared multi-agent contract)
#          governance/agents/models/gemma-lmstudio.md (LM Studio setup)
# ─────────────────────────────────────────────────────────────────────────────

# ══ 1. LM Studio local inference server ══════════════════════════════════════
# LM Studio exposes an OpenAI-compatible server (Developer tab → Start Server).
# Default host/port is 127.0.0.1:1234; the OpenAI-compatible routes live under
# /v1. Confirm the exact URL in LM Studio's Developer tab before relying on it.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# LM Studio does not require a real key, but OpenAI-compatible clients refuse to
# start without SOMETHING in this field. Any non-empty string works.
LMSTUDIO_API_KEY=lm-studio

# The model identifier as LM Studio reports it. Get the exact string from
# `GET {LMSTUDIO_BASE_URL}/models` or the Developer tab — do not guess it, a
# mismatched id is the most common "model not found" cause.
LMSTUDIO_MODEL=gemma-4-e4b

# Context window you loaded the model with, in tokens. Kept here so tooling and
# your own prompt-budgeting agree. See gemma-lmstudio.md for why this number
# governs how much of the repo you can paste in one turn.
LMSTUDIO_CONTEXT_TOKENS=8192

# ══ 2. OpenAI-compatible aliases ═════════════════════════════════════════════
# Most local-AI tooling (Continue, Cline, aider, the openai SDK, curl examples)
# reads OPENAI_* rather than LMSTUDIO_*. Mirroring the values here means you
# point those tools at the local model instead of a paid cloud endpoint.
# Keep them identical to the block above.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=gemma-4-e4b

# ══ 3. Agent identity (multi-agent attribution) ══════════════════════════════
# Who this machine's local agent is, per governance/agents/REGISTRY.md.
# These feed the commit trailers defined in governance/agents/attribution.md so
# it is always clear which assistant produced a change.
DOVA_AGENT_ID=@build/ember
DOVA_AGENT_MODEL=gemma-lmstudio

# ══ 4. Document rendering (client-jobs tools) ════════════════════════════════
# workspaces/client-jobs/tools/render-pdf.js reads these from the SHELL — it has
# no dotenv dependency, so they are recorded here for reference and must be
# exported manually, e.g.
#   PowerShell:  $env:CHROME_PATH = "C:\Program Files\Google\Chrome\Application\chrome.exe"
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Extra Chrome flags. Needed on Linux/root (`--no-sandbox`); leave empty on
# Windows. Added as a hook in BROLL-03 — see client-jobs done-log.
CHROME_ARGS=
